<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KnowledgeBase.Desktop.ViewModels"
        xmlns:models="using:KnowledgeBase.Desktop.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="using:Markdown.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="800"
        x:Class="KnowledgeBase.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/bulb.ico"
        Title="Knowledge Base"
        Width="1440" Height="800"
        MinWidth="1000" MinHeight="600">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid.KeyBindings>
            <KeyBinding Gesture="Cmd+K" Command="{Binding OpenSearchCommand}" />
            <KeyBinding Gesture="Escape" Command="{Binding CloseSearchCommand}" />
        </Grid.KeyBindings>

        <Border Grid.Row="0" Padding="8" Background="#202020">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Source="/Assets/bulb.png" Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock Text="Knowledge Base" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FFD65A" Margin="0,0,16,0" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="New Workspace" Command="{Binding OpenNewWorkspaceCommand}" />
                <Button Content="Delete Workspace" Command="{Binding DeleteWorkspaceCommand}" />
                <Button Content="New Note" Command="{Binding NewNoteCommand}" />
                <Button Content="Delete Note" Command="{Binding DeleteNoteCommand}" />
                <Button Content="Search (⌘K)" Command="{Binding OpenSearchCommand}" />
                <Button Content="Tags" Command="{Binding OpenTagManagerCommand}" />
                <Button Content="Graph" Command="{Binding OpenGraphCommand}" />
                <Button Content="Import Link" Command="{Binding OpenImportLinkCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="360,*">
            <Border Grid.Column="0" Background="#1E1E1E">
                <TreeView ItemsSource="{Binding Tree.Workspaces}"
                          SelectedItem="{Binding Tree.SelectedItem, Mode=TwoWay}">
                    <TreeView.DataTemplates>
                        <TreeDataTemplate ItemsSource="{Binding Notes}" DataType="{x:Type vm:WorkspaceNode}">
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            </StackPanel>
                        </TreeDataTemplate>
                        <DataTemplate DataType="{x:Type vm:NoteNode}">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                <TextBlock Text="•" Foreground="#FFD65A" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
            </Border>

            <Border Grid.Column="1" Background="#282828" Padding="12" IsVisible="{Binding IsEditorVisible}">
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,120">
                        <TextBox Grid.Column="0" Text="{Binding NoteTitle}" PlaceholderText="Note title"
                                 FontSize="20" FontWeight="SemiBold"
                                 Background="Transparent" BorderThickness="0" />
                        <Button Grid.Column="1" Content="Toggle Preview" Command="{Binding TogglePreviewCommand}"
                                HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                        <TextBlock Text="Edit (Markdown)" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TabControl Grid.Column="1" Margin="0" MinHeight="300">
                            <TabItem Header="Editor">
                                <TextBox Text="{Binding NoteContent}" AcceptsReturn="True"
                                         PlaceholderText="Write in Markdown..."
                                         MinWidth="200" />
                            </TabItem>
                            <TabItem Header="Preview">
                                <md:MarkdownScrollViewer Markdown="{Binding PreviewMarkdown}" />
                            </TabItem>
                        </TabControl>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <TextBox Grid.Column="0" Text="{Binding NoteTagsText}"
                                 PlaceholderText="Tags, comma separated (e.g. dotnet, database)" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                            <TextBlock Text="Available:" VerticalAlignment="Center" />
                            <ItemsControl ItemsSource="{Binding AvailableTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TagItem}">
                                        <Border Background="#3A3A3A" CornerRadius="8" Margin="2,0,2,0" Padding="6,2">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" Foreground="#E0E0E0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding CancelNoteCommand}" />
                        <Button Content="Save Note" Command="{Binding SaveNoteCommand}" IsDefault="True" Classes="accent" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="10,6" Background="#202020">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#BBBBBB" TextTrimming="CharacterEllipsis" />
        </Border>

        <Panel Grid.RowSpan="3" IsVisible="{Binding Search.IsOpen}">
            <Border Background="#AA000000" />
            <Grid VerticalAlignment="Center" MaxWidth="720" Margin="40">
                <Border Background="#1E1E1E" CornerRadius="8" BorderBrush="#3A3A3A" BorderThickness="1"
                        Padding="16" BoxShadow="0 8 24 0 #00000099">
                    <StackPanel Spacing="8">
                        <TextBox Text="{Binding Search.SearchText}"
                                 PlaceholderText="Search notes, topics, content... (Enter to open, Esc to close)"
                                 FontSize="18" />

                        <TextBlock Text="{Binding Search.TotalCount, StringFormat='{}{0} results'}"
                                   Foreground="#888888" />

                        <ListBox ItemsSource="{Binding Search.Results}"
                                 SelectedItem="{Binding Search.SelectedItem, Mode=TwoWay}"
                                 MaxHeight="320">
                            <ListBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding Search.OpenSelectedCommand}" />
                            </ListBox.KeyBindings>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:NoteSearchItem}">
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding WorkspaceName}" Foreground="#8FC7FF" FontSize="12" />
                                            <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#666666" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Tags, StringFormat='{}#{0}'}" Foreground="#7ABFA3" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="No results found" Foreground="#888888" IsVisible="{Binding Search.NoResults}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Panel>
    </Grid>
</Window>