<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KnowledgeBase.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="260"
        x:Class="KnowledgeBase.Desktop.Views.NewWorkspaceWindow"
        x:DataType="vm:NewWorkspaceViewModel"
        Title="New Workspace"
        Width="420" Height="260"
        ShowInTaskbar="False">

    <Design.DataContext>
        <vm:NewWorkspaceViewModel />
    </Design.DataContext>

    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Create a workspace" FontWeight="Bold" FontSize="16" />
        <TextBlock Text="Workspaces group related notes together in the tree view."
                   Foreground="#888888" TextWrapping="Wrap" />

        <TextBox Text="{Binding Name}" PlaceholderText="Workspace name" FontSize="15" />
        <TextBox Text="{Binding Description}" PlaceholderText="Description (optional)" AcceptsReturn="True" Height="60" />

        <TextBlock Text="{Binding StatusMessage}" Foreground="#8FC7FF" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Create" Command="{Binding CreateCommand}" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>